#!/bin/bash
# ============================================================
# MLC 命令行入口：mlc <linux-arm64-程序> [参数...]
#
# 与直接调 mlc-core 的区别：这里负责在 rootfs 里按客户机 PATH 找程序、
# 透传参数、原样返回客户机退出码。翻译器本体仍是 src/mlc-core。
# ============================================================
set -uo pipefail

# 安装位置探测。这份脚本会被拷到 ~/.local/bin/mlc，那时"脚本所在目录的上一级"
# 是 ~/.local 而不是项目根，CORE 与 ROOTFS 全都指向不存在的地方。
# 因此安装时会把真实项目根写进 INSTALL_HOME（留空表示就在项目里直接跑）。
# 顺序：环境变量 MLC_HOME > 安装时写死的 INSTALL_HOME > 脚本相对位置。
INSTALL_HOME=""

find_home() {
    if [ -n "${MLC_HOME:-}" ] && [ -x "${MLC_HOME}/src/mlc-core" ]; then
        printf '%s\n' "${MLC_HOME}"; return 0
    fi
    if [ -n "$INSTALL_HOME" ] && [ -x "$INSTALL_HOME/src/mlc-core" ]; then
        printf '%s\n' "$INSTALL_HOME"; return 0
    fi
    local self
    self="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
    if [ -n "$self" ] && [ -x "$self/src/mlc-core" ]; then
        printf '%s\n' "$self"; return 0
    fi
    return 1
}

if ! MLC_HOME="$(find_home)"; then
    # 全角标点必须写成 ${CORE}：bash 3.2 在 LC_CTYPE=C.UTF-8 下会把紧邻的全角
    # 字符并进变量名，$CORE，会被解析成变量 CORE，set -u 直接让脚本退出
    # （2026-11-06 实测复现，同一个坑在本项目已第三次出现）
    echo "mlc: 找不到 src/mlc-core。若把 mlc 拷到了别处，请在 INSTALL_HOME 里填项目根目录" >&2
    echo "mlc: 或设环境变量 MLC_HOME=/路径/mac-linux-compat" >&2
    exit 127
fi

CORE="$MLC_HOME/src/mlc-core"
ROOTFS="$MLC_HOME/rootfs/sysroot"

# 客户机 PATH：与 Ubuntu base 默认一致，rootfs 里没有的目录自动跳过
GUEST_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

die() { echo "mlc: $*" >&2; exit 127; }

[ -x "$CORE" ] || die "找不到翻译器核心：${CORE}"
[ -d "$ROOTFS" ] || die "找不到 rootfs：${ROOTFS}"

[ $# -ge 1 ] || {
    cat >&2 <<EOF
用法: mlc <程序> [参数...]
     mlc --list              列出 rootfs 里可运行的程序
     mlc --path <客户机路径>  直接指定客户机绝对路径

示例: mlc ls -la /
      mlc cat /etc/hostname
      mlc bash -c 'echo hi'
EOF
    exit 2
}

case "$1" in
    --list)
        for d in $(echo "$GUEST_PATH" | tr ':' ' '); do
            [ -d "$ROOTFS$d" ] || continue
            for f in "$ROOTFS$d"/*; do
                [ -f "$f" ] && [ -x "$f" ] || continue
                printf '%s\n' "${f#$ROOTFS}"
            done
        done | sort -u
        exit 0
        ;;
    --path)
        [ $# -ge 2 ] || die "--path 需要客户机绝对路径"
        GPATH="$2"; shift 2
        ;;
    *)
        GPATH=""
        for d in $(echo "$GUEST_PATH" | tr ':' ' '); do
            if [ -x "$ROOTFS$d/$1" ]; then GPATH="$d/$1"; break; fi
        done
        [ -n "${GPATH}" ] || die "rootfs 里找不到程序：$1（mlc --list 看有哪些）"
        shift
        ;;
esac

HPATH="$ROOTFS$GPATH"
[ -f "$HPATH" ] || die "客户机路径不存在：$GPATH"
[ -x "$HPATH" ] || die "客户机程序没有可执行位：$GPATH"

# 退出码原样透传：客户机 exit(3) 就得让 shell 看到 3
exec "$CORE" "$HPATH" "$@"
